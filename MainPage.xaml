<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShortsGuard.MainPage"
             Title="BlockShotsStop"
             BackgroundColor="{StaticResource PageBackground}"
             SafeAreaEdges="Container">
    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,24" Spacing="14">
            <Border x:Name="SetupPanel"
                    Padding="16"
                    BackgroundColor="{StaticResource PanelBackground}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    IsVisible="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Настройте блокировку" Style="{StaticResource SectionHeading}" />
                    <Label Text="Служба специальных возможностей распознаёт короткие видео по элементам экрана и закрывает их. Диагностика хранится на устройстве." />
                    <Label Text="В настройках Android выберите BlockShotsStop, включите службу и вернитесь сюда."
                           TextColor="{StaticResource SecondaryText}" />
                    <Button Text="Настроить и включить защиту"
                            BackgroundColor="{StaticResource Accent}"
                            TextColor="{StaticResource PageBackground}"
                            Clicked="OnSetupClicked" />
                    <Button x:Name="RestrictedSettingsHelp"
                            Text="Android не даёт включить службу?"
                            Clicked="OnRestrictedSettingsHelpClicked" />
                </VerticalStackLayout>
            </Border>
            <Border Padding="16,10"
                    BackgroundColor="{StaticResource PanelBackground}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="Включить защиту" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" />
                        <Switch x:Name="ProtectionSwitch" Grid.Column="1" SemanticProperties.Description="Включить защиту" />
                    </Grid>
                    <Label x:Name="ProtectionStatus" FontAttributes="Bold" />
                    <Label x:Name="ServiceStatus" TextColor="{StaticResource SecondaryText}" />
                    <Label x:Name="ExitCount" Margin="0,4,0,0" TextColor="{StaticResource SecondaryText}" />
                </VerticalStackLayout>
            </Border>
            <Button x:Name="ServiceSettingsButton"
                    Text="Настроить службу Android"
                    Clicked="OnAccessibilitySettingsClicked" />

            <Label Text="Блокировать короткие видео" Margin="0,8,0,0" Style="{StaticResource SectionHeading}" />
            <Border Padding="16,4"
                    BackgroundColor="{StaticResource PanelBackground}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12">
                    <Label Text="YouTube Shorts" VerticalOptions="Center" />
                    <Switch x:Name="YouTubeSwitch" Grid.Column="1" SemanticProperties.Description="Блокировать YouTube Shorts" />
                    <Label Grid.Row="1" Text="Клипы ВКонтакте" VerticalOptions="Center" />
                    <Switch x:Name="VkSwitch" Grid.Row="1" Grid.Column="1" SemanticProperties.Description="Блокировать клипы ВКонтакте" />
                    <Label Grid.Row="2" Text="Клипы VK Видео" VerticalOptions="Center" />
                    <Switch x:Name="VkVideoSwitch" Grid.Row="2" Grid.Column="1" SemanticProperties.Description="Блокировать клипы VK Видео" />
                    <Label Grid.Row="3" Text="Instagram Reels" VerticalOptions="Center" />
                    <Switch x:Name="InstagramSwitch" Grid.Row="3" Grid.Column="1" SemanticProperties.Description="Блокировать Instagram Reels" />
                </Grid>
            </Border>

            <Label Text="Проверить блокировку" Margin="0,8,0,0" Style="{StaticResource SectionHeading}" />
            <VerticalStackLayout Spacing="8">
                <Button Text="Открыть YouTube" Clicked="OnOpenYouTubeClicked" />
                <Button Text="Открыть ВКонтакте" Clicked="OnOpenVkClicked" />
                <Button Text="Открыть VK Видео" Clicked="OnOpenVkVideoClicked" />
                <Button Text="Открыть Instagram" Clicked="OnOpenInstagramClicked" />
            </VerticalStackLayout>
            <Button Text="Диагностика распознавания" Clicked="OnDiagnosticsClicked" />
            <Button Text="О приложении и доступе" Clicked="OnAboutClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
