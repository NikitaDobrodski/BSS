<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShortsGuard.DiagnosticsPage"
             Title="Диагностика"
             BackgroundColor="{StaticResource PageBackground}"
             SafeAreaEdges="Container">
    <Grid Padding="20,12,20,24" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <Picker x:Name="AppPicker"
                Title="Выберите приложение"
                TextColor="{StaticResource PrimaryText}"
                SemanticProperties.Description="Приложение для диагностики"
                MinimumHeightRequest="48"
                SelectedIndexChanged="OnAppChanged" />
        <ScrollView x:Name="ReportScroll" Grid.Row="1" BackgroundColor="{StaticResource PanelBackground}">
            <Label x:Name="Report" Padding="12" FontSize="13" />
        </ScrollView>
        <Button Grid.Row="2" Text="Копировать отчёт" Clicked="OnCopyClicked" />
    </Grid>
</ContentPage>
